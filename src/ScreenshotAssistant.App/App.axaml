<Application
    x:Class="ScreenshotAssistant.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ShareX.Avalonia/Theming/ShareXTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ShareX.Avalonia/Theming/ControlStyles.axaml" />
        <StyleInclude Source="avares://ShareX.Avalonia/Theming/ToolStyles.axaml" />
    </Application.Styles>
</Application>
